script/source = "extends Node

@export_range(1 , 100) var num_of_keys : int = 1 
@export var gate_collider : CollisionPolygon2D

func check_keys():
	if num_of_keys == 0:
		$GateUnlock.play()
		gate_collider.set_deferred(\"disabled\" , true)
		get_parent().hide()
		await $GateUnlock.finished
		queue_free()
"

